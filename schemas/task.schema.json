{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACP Task",
  "type": "object",
  "required": [
    "task_id",
    "primary_project",
    "objective",
    "scope",
    "acceptance_criteria",
    "state"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "primary_project": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "NEW",
        "TRIAGE",
        "NEEDS_HUMAN",
        "PLANNED",
        "READY",
        "RUNNING",
        "BLOCKED",
        "FAILED",
        "REVIEW",
        "REWORK",
        "DONE"
      ]
    }
  }
}
